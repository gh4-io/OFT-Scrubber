<Window x:Class="OftScrubber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:preview="clr-namespace:OftScrubber.Preview"
        Title="OFT Scrubber"
        Height="780" Width="1220"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        AllowDrop="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewDragEnter="OnDragEnter"
        PreviewDragOver="OnDragEnter"
        PreviewDragLeave="OnDragLeave"
        PreviewDrop="OnDrop">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open" />
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpen" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="OnSaveDraft" />
    </Window.CommandBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Small dropdown chip for a variable's type and format; the menu is built in code. -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="Transparent"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="7,1,5,1">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;"
                                           Style="{StaticResource IconGlyph}"
                                           FontSize="8"
                                           Margin="5,1,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One logical variable: one value, however many tokens share it. -->
        <DataTemplate x:Key="VariableTemplate">
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8,10,10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="•"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="13"
                                   Margin="0,0,5,0"
                                   VerticalAlignment="Center"
                                   ToolTip="No usable value yet: the token stays in the email as written"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Style="{StaticResource ChipButton}"
                                Content="{Binding TypeText}"
                                Margin="6,0,6,0"
                                VerticalAlignment="Center"
                                Click="OnTypeMenu"
                                ToolTip="What kind of value this is"
                                AutomationProperties.Name="{Binding TypeAutomationName}" />
                        <Border Grid.Column="3"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="8"
                                Padding="7,1"
                                VerticalAlignment="Center"
                                ToolTip="Number of places this value is used">
                            <TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </Grid>

                    <!-- Text, time, number, web and email addresses. -->
                    <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{Binding AutomationName}"
                             AcceptsReturn="{Binding IsMultiLine}"
                             TextWrapping="Wrap"
                             MaxHeight="120"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,6,0,0"
                             Visibility="{Binding ShowTextBox, Converter={StaticResource BoolToVis}}" />

                    <!-- Date, with an optional time beside it. -->
                    <Grid Margin="0,6,0,0" Visibility="{Binding ShowDate, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding DateAutomationName}" />
                        <Button x:Name="CalendarButton"
                                Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Tag="&#xE787;"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Click="OnCalendar"
                                ToolTip="Pick a date"
                                AutomationProperties.Name="{Binding CalendarAutomationName}" />
                        <TextBox Grid.Column="2"
                                 Width="92"
                                 Margin="6,0,0,0"
                                 Text="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding TimeAutomationName}"
                                 ToolTip="Time, such as 14:30 or 2:30 pm"
                                 Visibility="{Binding ShowTime, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!-- Label for a clickable link. -->
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding ShowLinkText, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Text to show (optional)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding LinkText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding LinkTextAutomationName}" />
                    </StackPanel>

                    <Grid Margin="0,5,0,3" Visibility="{Binding ShowResultRow, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ResultText}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1"
                                Style="{StaticResource ChipButton}"
                                MaxWidth="150"
                                Margin="6,0,0,0"
                                VerticalAlignment="Top"
                                Click="OnFormatMenu"
                                Visibility="{Binding ShowFormat, Converter={StaticResource BoolToVis}}"
                                ToolTip="How the value is written in the email"
                                AutomationProperties.Name="{Binding FormatAutomationName}">
                            <TextBlock Text="{Binding FormatText}" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" TextTrimming="CharacterEllipsis" />
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding Detail}"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Detail}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <DockPanel>

        <Popup x:Name="CalendarPopup"
               StaysOpen="False"
               Placement="Bottom"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="4"
                    Margin="0,2,8,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" />
                </Border.Effect>
                <Calendar x:Name="DateCalendar"
                          BorderThickness="0"
                          Background="Transparent"
                          AutomationProperties.Name="Calendar"
                          SelectedDatesChanged="OnCalendarPicked" />
            </Border>
        </Popup>

        <!-- Menu bar: File stays a dropdown, everything else is a ribbon tab. -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,2,6,0">
            <StackPanel Orientation="Horizontal">
                <Menu VerticalAlignment="Center" Margin="0,0,4,2">
                    <MenuItem Header="_File">
                        <MenuItem Header="Open template…" InputGestureText="Ctrl+O" Click="OnOpen" />
                        <Separator />
                        <MenuItem x:Name="MenuSaveDraft" Header="Save draft as…" InputGestureText="Ctrl+S" Click="OnSaveDraft" />
                        <MenuItem x:Name="MenuOpenDraft" Header="Open as draft in mail app" Click="OnOpenDraft" />
                        <Separator />
                        <MenuItem x:Name="MenuClearValues" Header="Clear all values" Click="OnClearValues" />
                        <Separator />
                        <MenuItem Header="Exit" Click="OnExit" />
                    </MenuItem>
                </Menu>

                <ToggleButton x:Name="TabHome" Style="{StaticResource RibbonTab}" Content="Home" Checked="OnTabChanged" Unchecked="OnTabChanged" />
                <ToggleButton x:Name="TabHelp" Style="{StaticResource RibbonTab}" Content="Help" Checked="OnTabChanged" Unchecked="OnTabChanged" />
            </StackPanel>
        </Border>

        <!-- Command bar: shows the selected tab's buttons and nothing else. -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="7,4,7,2"
                MinHeight="92">
            <Grid>
                <StackPanel x:Name="PanelHome" Orientation="Horizontal">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE8E5;" Content="Open"
                                    Foreground="{StaticResource AccentBrush}"
                                    Click="OnOpen" ToolTip="Open an Outlook template (Ctrl+O)" />
                        </StackPanel>
                        <TextBlock Text="Template" Style="{StaticResource RibbonGroupLabel}" />
                    </StackPanel>

                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="6,4,6,20" />

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnSaveDraft" Style="{StaticResource RibbonButton}" Tag="&#xE792;" Content="Save draft"
                                    Foreground="{StaticResource AccentBrush}"
                                    Click="OnSaveDraft" ToolTip="Save the completed email as an .eml draft (Ctrl+S)" />
                            <Button x:Name="BtnOpenDraft" Style="{StaticResource RibbonButton}" Tag="&#xE715;" Content="Open in mail app"
                                    Click="OnOpenDraft" ToolTip="Save a draft and open it in your mail app, where you review it and press Send" />
                        </StackPanel>
                        <TextBlock Text="Output" Style="{StaticResource RibbonGroupLabel}" />
                    </StackPanel>

                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="6,4,6,20" />

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnClearValues" Style="{StaticResource RibbonButton}" Tag="&#xE894;" Content="Clear values"
                                    Click="OnClearValues" ToolTip="Empty every variable" />
                        </StackPanel>
                        <TextBlock Text="Variables" Style="{StaticResource RibbonGroupLabel}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="PanelHelp" Orientation="Horizontal" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonButton}" Tag="&#xE946;" Content="About" Click="OnAbout" />
                        </StackPanel>
                        <TextBlock Text="Help" Style="{StaticResource RibbonGroupLabel}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,7">
            <TextBlock x:Name="StatusText"
                       Text="Drop an .oft file anywhere in this window to begin."
                       Style="{StaticResource SecondaryText}"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Panes -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="240" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Template and variables -->
            <Border Background="{StaticResource SubtleBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,10,14,6">
                        <TextBlock Text="Template" Style="{StaticResource PaneTitle}" />
                        <TextBlock x:Name="TemplateName"
                                   Text="No template open"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TemplateSummary"
                                   Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="Detected variables" Style="{StaticResource PaneTitle}" />
                            <TextBlock x:Name="FilledText"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryText}" />
                        </Grid>
                    </StackPanel>

                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,4,10,10">
                            <ItemsControl x:Name="VariableList"
                                          ItemTemplate="{StaticResource VariableTemplate}"
                                          KeyboardNavigation.TabNavigation="Continue" />
                        </ScrollViewer>

                        <TextBlock x:Name="VariablesEmptyText"
                                   Margin="18,8,18,0"
                                   Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap"
                                   Text="Open an .oft template. Tokens such as {{Name}}, [[Name]], ${Name}, &lt;&lt;Name&gt;&gt; and %%Name%% appear here, one field per name." />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Preview -->
            <Border Grid.Column="2"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,5,6,4">
                        <ToggleButton x:Name="ModePreview" Style="{StaticResource ModeToggle}" Content="Preview" Checked="OnModeChanged" Unchecked="OnModeChanged" />
                        <ToggleButton x:Name="ModeHtml" Style="{StaticResource ModeToggle}" Content="HTML" Checked="OnModeChanged" Unchecked="OnModeChanged" />
                        <ToggleButton x:Name="ModeDetails" Style="{StaticResource ModeToggle}" Content="Details" Checked="OnModeChanged" Unchecked="OnModeChanged" />
                    </StackPanel>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <!-- Preview: message header, then the rendered HTML. -->
                            <DockPanel x:Name="PreviewView">
                                <Border DockPanel.Dock="Top"
                                        Background="{StaticResource SubtleBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="16,10,16,10">
                                    <Grid x:Name="HeaderGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Subject" Style="{StaticResource SecondaryText}" Margin="0,0,14,4" />
                                        <TextBlock x:Name="SubjectText" Grid.Column="1" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />

                                        <TextBlock x:Name="ToLabel" Grid.Row="1" Text="To" Style="{StaticResource SecondaryText}" Margin="0,0,14,2" />
                                        <TextBlock x:Name="ToText" Grid.Row="1" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2" />

                                        <TextBlock x:Name="CcLabel" Grid.Row="2" Text="Cc" Style="{StaticResource SecondaryText}" Margin="0,0,14,2" />
                                        <TextBlock x:Name="CcText" Grid.Row="2" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2" />

                                        <TextBlock x:Name="BccLabel" Grid.Row="3" Text="Bcc" Style="{StaticResource SecondaryText}" Margin="0,0,14,2" />
                                        <TextBlock x:Name="BccText" Grid.Row="3" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2" />

                                        <TextBlock x:Name="AttachLabel" Grid.Row="4" Text="Attached" Style="{StaticResource SecondaryText}" Margin="0,0,14,0" />
                                        <TextBlock x:Name="AttachText" Grid.Row="4" Grid.Column="1" FontSize="12" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>

                                <Border x:Name="PreviewNotice"
                                        DockPanel.Dock="Top"
                                        Background="{StaticResource AccentSoftBrush}"
                                        Padding="16,6"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="PreviewNoticeText" FontSize="11.5" TextWrapping="Wrap" />
                                </Border>

                                <wfi:WindowsFormsHost x:Name="BrowserHost">
                                    <preview:SafeWebBrowser x:Name="Browser" />
                                </wfi:WindowsFormsHost>
                            </DockPanel>

                            <!-- Rendered HTML source, exactly as it will be written. -->
                            <TextBox x:Name="HtmlView"
                                     Style="{StaticResource CodeBox}"
                                     IsReadOnly="True"
                                     Visibility="Collapsed"
                                     AutomationProperties.Name="Rendered HTML source" />

                            <!-- Details: fidelity notes, warnings, and where each variable was found. -->
                            <ScrollViewer x:Name="DetailsView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <TextBlock x:Name="DetailsText"
                                           Margin="16,14,16,16"
                                           FontSize="12.5"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>

        <!-- Covers the whole window while a template is dragged over it. The preview browser is
             hidden meanwhile, because hosted WinForms content always draws above WPF. -->
        <Border x:Name="DropOverlay" Visibility="Collapsed">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource AccentColor}" Opacity="0.6" />
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE8E5;"
                           Style="{StaticResource IconGlyph}"
                           FontSize="46"
                           Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Drop to open"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
